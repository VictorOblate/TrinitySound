# Database
# MySQL connection string for Prisma
# Format: mysql://username:password@host:port/database_name
DATABASE_URL="mysql://app_user:Wolfie123@13.48.147.27:3306/trinity_sound"

# NextAuth Configuration
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_PROVIDERS="credentials"

# Admin Configuration
# Secret token to access hidden admin login link at /admin/secret?t=<token>
ADMIN_SECRET_LINK_TOKEN="super-secret-token-123"

# File Storage Configuration
# Using Vercel Blob for image storage (FREE - 100GB included with Vercel)
# Images are automatically compressed to WebP format before uploading
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token_here"

# To get this token:
# 1. Deploy your app to Vercel (vercel.com)
# 2. Go to Project Settings → Storage → Blob
# 3. Create a new Blob Store (or use default)
# 4. Copy the Token and paste it here
# 
# For local development:
# You can test without this token - uploads will fail gracefully
# But the app continues to work

# Next.js Configuration
NODE_ENV="development"
