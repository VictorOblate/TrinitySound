# Database
# MySQL connection string for Prisma
# Format: mysql://username:password@host:port/database_name
DATABASE_URL="mysql://app_user:Wolfie123@13.48.147.27:3306/trinity_sound"

# NextAuth Configuration
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_PROVIDERS="credentials"

# Admin Configuration
# Secret token to access hidden admin login link at /admin/secret?t=<token>
ADMIN_SECRET_LINK_TOKEN="super-secret-token-123"

# File Storage Configuration
# Choose one of the following options and configure:

# Option 1: UploadThing (recommended)
# UPLOADTHING_SECRET="your-uploadthing-secret"
# UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Option 2: AWS S3
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="trinity-sound-uploads"

# Option 3: Azure Blob Storage
# AZURE_STORAGE_ACCOUNT="your-storage-account"
# AZURE_STORAGE_KEY="your-storage-key"
# AZURE_STORAGE_CONTAINER="uploads"

# Option 4: Cloudinary
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# Option 5: Vercel Blob Storage
# BLOB_READ_WRITE_TOKEN="your-blob-token"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_HtTzazZOJ4CxSH1b_MhGQ7EtOS9Q2pAt5RniNmvwfINXizo"
# Next.js Configuration
NODE_ENV="development"
